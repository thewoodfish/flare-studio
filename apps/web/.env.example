# Copy to .env.local. Everything here is public -- these are testnet contract
# addresses and a public RPC, not secrets. The app runs without any of them,
# falling back to the Coston2 deployment recorded in lib/chain.ts.
#
# The authoritative values are written by:
#   cd packages/contracts && forge script script/Deploy.s.sol --rpc-url coston2 --broadcast
# which emits deployments/coston2.json. Copy them across after a redeploy.

NEXT_PUBLIC_POLICY_FACTORY=0xDC4DF7ea48D6c4B7839ff55C8D0E91F2B885326d
NEXT_PUBLIC_TEE_ATTESTOR_GATE=0x67C5D7DA5c66954579C19A55B59273D7a97594A6
NEXT_PUBLIC_MANUAL_HEARTBEAT_TRIGGER=0x395F139c4C8B9e1807D3Da259020BabA5E331D45
NEXT_PUBLIC_TIMESTAMP_TRIGGER=
NEXT_PUBLIC_FXRP=0x0b6A3645c240605887a5532109323A3E12273dc7

# The block the factory was deployed in. Coston2's RPC caps eth_getLogs ranges,
# so scanning from genesis is both slow and liable to be refused outright.
# `deployBlock` in deployments/coston2.json.
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=0

# PolicyInstructionSender, which carries the sealed policy on-chain to the
# enclave. Deployed by the extension scaffold's pre-build step, which writes it
# as INSTRUCTION_SENDER into apps/extension/config/extension.env -- that file is
# per-machine and not checked in, so there is no default here.
#
# Left empty, deploys still succeed and the hand-off is reported as skipped; the
# policy screen offers it again once this is set.
NEXT_PUBLIC_POLICY_INSTRUCTION_SENDER=

# The extension proxy's public URL -- the stable tunnel hostname, not a quick
# tunnel. Used to read the enclave's current public key so confidential inputs
# can be sealed to it in the browser. Left empty, deploys still work and the
# private half simply stays local.
NEXT_PUBLIC_EXT_PROXY_URL=
